{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node20",
    "moduleResolution": "node16",

    "rootDir": "src",
    "outDir": "dist",

    "lib": ["ES2022"],
    "types": ["node"],

    "paths": {
      "@domain/*": ["../../domain/dist/*"]
    },

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,

    "strict": true,
    "esModuleInterop": true,
    "noEmitOnError": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts", "**/*.test.ts"]
}
