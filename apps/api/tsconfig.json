{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
  "rootDir": "../../",

    "moduleResolution": "NodeNext",

    "target": "ES2022",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts", "**/*.test.ts"]
}
