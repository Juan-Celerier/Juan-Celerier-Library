{
  "name": "library-system-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Library System API - REST API layer",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1041.0",
    "@aws-sdk/lib-storage": "^3.1041.0",
    "@faker-js/faker": "^9.9.0",
    "@types/multer": "^2.1.0",
    "bcrypt": "6.0.0",
    "better-sqlite3": "^11.0.0",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "domain": "workspace:*",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.0.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "reflect-metadata": "^0.2.2",
    "sqlite3": "^5.1.7",
    "typeorm": "^0.3.25"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.14",
    "@types/express": "^5.0.3",
    "@types/express-rate-limit": "^6.0.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.0",
    "@types/node": "^20.19.16",
    "@types/sqlite3": "^5.1.0",
    "nodemon": "^3.0.1",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "5.9.3",
    "vitest": "^1.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "yarn build && node dist/server.js",
    "build": "tsc -p tsconfig.app.json",
    "db:seed:dev": "tsx src/scripts/seed-dev-db.ts",
    "db:seed:prod": "tsx src/scripts/seed-production.ts",
    "db:reset": "tsx src/scripts/reset-dev-db.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "type-check": "tsc --noEmit",
    "db:debug": "tsx src/scripts/debug-db.ts",
    "db:setup": "tsx src/scripts/setup-dev-db.ts",
    "db:seed": "tsx src/scripts/seed-dev-db.ts",
    "db:init": "npm run db:setup && npm run db:seed",
    "db:prod:seed": "tsx src/scripts/seed-production.ts",
   "clean:db": "rimraf data/library-system.sqlite"
  }
}
