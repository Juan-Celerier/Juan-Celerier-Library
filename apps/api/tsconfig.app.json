{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "baseUrl": "../../",
    "rootDir": "../..",
    "paths": {
      "domain/*": ["domain/src/*"]
    }
  },
  "include": ["src/**/*", "../../domain/src/**/*"],
  "exclude": ["**/*.spec.ts", "**/*.test.ts"]
}
