# ====================================
# CONFIGURACIÓN GENERAL DEL SISTEMA
# ====================================

# Entorno de ejecución
NODE_ENV=development

# ====================================
# CONFIGURACIÓN DEL API
# ====================================

# Puerto del API
API_PORT=3000
API_HOST=0.0.0.0

# Secreto JWT para tokens de autenticación.
# Genera un valor antes de iniciar Docker Compose: openssl rand -hex 32
JWT_SECRET=

# ====================================
# CONFIGURACIÓN DEL WEB
# ====================================

# Puerto del Frontend
WEB_PORT=4173

# URL base del API para el cliente web
# En desarrollo local: http://api:3000
# En producción: https://api.tudominio.com
VITE_API_BASE_URL=http://api:3000

# Usar mocks en lugar de API real (para desarrollo/testing)
VITE_USE_MOCKS=false

# ====================================
# CONFIGURACIÓN DE BASE DE DATOS
# (Opcional si usas PostgreSQL)
# ====================================

# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=library_system
# DB_USER=library_user
# DB_PASSWORD=secure-password-change-this

# ====================================
# CONFIGURACIÓN NGINX (Opcional)
# ====================================

# NGINX_PORT=80
# NGINX_SSL_PORT=443
